                  "cursor": "pointer",
                  "ariaLabel": { "ko": "거실로 돌아가기", "en": "Return to living room" }
                }
              ]
            }
          ],
          "puzzles": {
            "main": {
              "id": "puzzle-case1-main",
              "title": { "ko": "사건의 진상", "en": "The Truth of the Case" },
              "description": {
                "ko": "단서를 바탕으로 빈칸을 채워 사건의 진상을 밝혀라.",
                "en": "Fill in the blanks based on clues to reveal the truth."
              },
              "type": "fill_in_blank",
              "template": {
                "segments": [
                  { "type": "slot", "slotId": "killer", "placeholder": { "ko": "범인", "en": "killer" }, "acceptCategory": "person" },
                  { "type": "text", "content": { "ko": "이(가) ", "en": " attacked the victim in " } },
                  { "type": "slot", "slotId": "place", "placeholder": { "ko": "장소", "en": "place" }, "acceptCategory": "place" },
                  { "type": "text", "content": { "ko": "에서 ", "en": " using " } },
                  { "type": "slot", "slotId": "weapon", "placeholder": { "ko": "무기", "en": "weapon" }, "acceptCategory": "object" },
                  { "type": "text", "content": { "ko": "을(를) 사용하여 피해자를 공격했다.", "en": "." } }
                ]
              },
              "answers": {
                "killer": { "correctWordId": "word-secretary-kim" },
                "place": { "correctWordId": "word-study", "partiallyCorrectWordIds": ["word-living-room"] },
                "weapon": { "correctWordId": "word-knife" }
