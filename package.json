{
  "name": "gi-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Golden Idol style detective/deduction game engine",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:editor": "playwright test --config=playwright.editor.config.ts",
    "test:e2e:editor:update": "PLAYWRIGHT_UPDATE_SNAPSHOTS=all playwright test --config=playwright.editor.config.ts",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/tests/**/*.ts\"",
    "typecheck": "tsc --build",
    "ci:check": "npm run lint && npm run typecheck && npm test && npm run build",
    "ci:check:e2e": "npm run ci:check && npm run test:e2e:editor || true",
    "prd:index": "npx tsx scripts/prd-indexer.ts",
    "prd:query": "npx tsx scripts/prd-query.ts",
    "prd:test": "npx vitest run --config scripts/vitest.config.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.1.0"
  }
}
